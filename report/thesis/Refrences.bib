@article{rERP_1,
	title = {Regression-based estimation of {ERP} waveforms: {I}. {The} {rERP} framework},
	volume = {52},
	copyright = {© 2014 Society for Psychophysiological Research},
	issn = {1469-8986},
	shorttitle = {Regression-based estimation of {ERP} waveforms},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/psyp.12317},
	doi = {10.1111/psyp.12317},
	abstract = {ERP averaging is an extraordinarily successful method, but can only be applied to a limited range of experimental designs. We introduce the regression-based rERP framework, which extends ERP averaging to handle arbitrary combinations of categorical and continuous covariates, partial confounding, nonlinear effects, and overlapping responses to distinct events, all within a single unified system. rERPs enable a richer variety of paradigms (including high-N naturalistic designs) while preserving the advantages of traditional ERPs. This article provides an accessible introduction to what rERPs are, why they are useful, how they are computed, and when we should expect them to be effective, particularly in cases of partial confounding. A companion article discusses how nonlinear effects and overlap correction can be handled within this framework, as well as practical considerations around baselining, filtering, statistical testing, and artifact rejection. Free software implementing these techniques is available.},
	language = {en},
	number = {2},
	urldate = {2025-06-10},
	journal = {Psychophysiology},
	author = {Smith, Nathaniel J. and Kutas, Marta},
	year = {2015},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/psyp.12317},
	keywords = {EEG/ERP, Language/Speech, Normal volunteers, Other},
	pages = {157--168},
	file = {Akzeptierte Version:/Users/jansauter/Zotero/storage/G929WTAV/Smith und Kutas - 2015 - Regression-based estimation of ERP waveforms I. The rERP framework.pdf:application/pdf;Snapshot:/Users/jansauter/Zotero/storage/R9H7EYAC/psyp.html:text/html},
}

@article{rERP_2,
	title = {Regression-based estimation of {ERP} waveforms: {II}. {Non}-linear effects, overlap correction, and practical considerations},
	volume = {52},
	issn = {0048-5772},
	shorttitle = {Regression-based estimation of {ERP} waveforms},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC5306445/},
	doi = {10.1111/psyp.12320},
	abstract = {A companion paper introduced the rERP framework, which re-casts traditional ERP averaging as a special case of a more flexible regression-based approach to estimating ERP waveforms. Here, we build on this foundation, showing how rERP analysis can also handle the estimation of non-linear effects (a generalization of both the well-known approach of dichotomizing continuous covariates, and also of the ERP image technique), and can disentangle overlapping ERPs to temporally adjacent stimuli. We then consider how the use of rERPs impacts on other parts of the EEG analysis pipeline, including baselining, filtering, significance testing, and artifact rejection, and provide practical recommendations. Free software implementing these techniques is available.},
	number = {2},
	urldate = {2025-10-27},
	journal = {Psychophysiology},
	author = {Smith, Nathaniel J. and Kutas, Marta},
	month = feb,
	year = {2015},
	pmid = {25195691},
	pmcid = {PMC5306445},
	pages = {169--181},
	file = {Full Text PDF:/Users/jansauter/Zotero/storage/TKTBBFNA/Smith und Kutas - 2015 - Regression-based estimation of ERP waveforms II. Non-linear effects, overlap correction, and practi.pdf:application/pdf},
}

